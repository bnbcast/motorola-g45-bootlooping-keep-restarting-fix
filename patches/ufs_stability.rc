on boot
    write /sys/devices/platform/soc/4804000.ufshc/auto_hibern8 0
    write /sys/devices/platform/soc/4804000.ufshc/clkscale_enable 0
    write /proc/sys/kernel/panic_on_oops 0

on property:sys.boot_completed=1
    write /sys/devices/platform/soc/4804000.ufshc/auto_hibern8 0
    write /sys/devices/platform/soc/4804000.ufshc/clkscale_enable 0
    write /proc/sys/kernel/panic_on_oops 0
